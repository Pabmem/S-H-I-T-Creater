{
  "name": "mood-background",
  "displayName": "Mood Background",
  "description": "实时分析代码质量，用情绪图片作为编辑器背景",
  "version": "0.1.0",
  "publisher": "S-H-I-T-Creater",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "moodBackground.enable",
        "title": "Mood Background: Enable"
      },
      {
        "command": "moodBackground.disable",
        "title": "Mood Background: Disable"
      },
      {
        "command": "moodBackground.toggle",
        "title": "Mood Background: Toggle"
      },
      {
        "command": "moodBackground.refresh",
        "title": "Mood Background: Refresh Emotion Now"
      }
    ],
    "configuration": {
      "title": "Mood Background",
      "properties": {
        "moodBackground.enabled": {
          "type": "boolean",
          "default": true,
          "description": "是否启用情绪背景"
        },
        "moodBackground.opacity": {
          "type": "number",
          "default": 0.15,
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "背景图片透明度 (0.0 ~ 1.0)"
        },
        "moodBackground.updateInterval": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "情绪分析间隔（秒）"
        },
        "moodBackground.linesToAnalyze": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "分析最近 N 行代码"
        },
        "moodBackground.transitionDuration": {
          "type": "number",
          "default": 1.5,
          "minimum": 0.1,
          "maximum": 10.0,
          "description": "图片渐变切换时长（秒）"
        },
        "moodBackground.imagesFolder": {
          "type": "string",
          "default": "",
          "description": "自定义情绪图片目录路径（留空使用插件内置 images 目录）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.5.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.0"
  }
}
